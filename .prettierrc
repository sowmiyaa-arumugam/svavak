# Prettier settings (YAML form of the sample's .prettierrc), applied through ESLint's prettier/prettier rule.

printWidth: 120  # maximum line length
tabWidth: 2  # spaces per indentation level
useTabs: false  # indent with spaces
semi: true  # end statements with semicolons
singleQuote: true  # 'single' quotes in TypeScript
trailingComma: all  # trailing commas wherever they are valid
bracketSpacing: true  # spaces inside object braces
bracketSameLine: true  # the sample's jsxBracketSameLine, under the name Prettier 3 uses
