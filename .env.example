# Example environment. Copy to .env (git-ignored): as it is, it runs mock mode, including the studio.
# Placeholders and the two public demo tokens only: never put a real token, key or personal value in this file.
# AWS credentials are never stored in any file here; sign in with AWS IAM Identity Center (SSO).
# Read by the server (services/server), the agent (services/agent), the TV app's build (apps/tv/app.config.js), the
# studio's dev server (apps/studio/vite.config.ts), tools/smoke-stream.mjs and tools/mcp-smoke.mjs.

# AI mode: "mock" needs no credentials (the default); "live" calls Bedrock and Polly
SVAVAK_MODE=mock

# Static bearer token for every server call except /healthz and /mcp; the TV's debug build and the studio's dev page embed it.
# At least 16 characters; the studio needs letters, digits or !#$%&'*+.^_`|~- only (it sends the token as a WebSocket subprotocol).
# Demo token (public, mock mode only): anyone can read it here, so the server and the agent refuse it in live mode.
# For live mode, generate your own with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SVAVAK_DEVICE_TOKEN=svavak-public-demo-device-token

# Bearer token for caregiver or agent MCP clients: /mcp accepts only this one, and the TV's routes refuse it.
# At least 16 characters, and different from the device token.
# Demo token (public, mock mode only): anyone can read it here, so the server and the agent refuse it in live mode.
# For live mode, generate your own the same way.
SVAVAK_AGENT_TOKEN=svavak-public-demo-agent-token

# Host names /mcp accepts, comma-separated (DNS-rebinding protection); the TV's routes are not checked
SVAVAK_MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Browser origins /mcp accepts, comma-separated (the studio by default); requests without an Origin header are allowed
SVAVAK_MCP_ALLOWED_ORIGINS=http://localhost:5173

# AWS named profile created by `aws login --profile <name>` or `aws configure sso`; read only in live mode
AWS_PROFILE=<your-sso-profile-name>

# AWS region for Bedrock, and for Polly unless SVAVAK_POLLY_REGION is set (plan §8.1: Frankfurt, EU processing)
AWS_REGION=eu-central-1

# Bedrock model id: Nova 2 Lite through the EU geo inference profile (plan §8.1); live mode only
SVAVAK_MODEL_ID=eu.amazon.nova-2-lite-v1:0

# Amazon Polly voice; it must exist for the engine in Polly's region (British English: Amy, Emma, Brian, Arthur
# with neural in eu-central-1; Amy, Emma, Brian with standard in eu-north-1); live mode only
SVAVAK_VOICE=Brian

# Polly's region, if it differs from AWS_REGION (empty: AWS_REGION); live mode only
SVAVAK_POLLY_REGION=

# Polly engine: "neural" (the default) or "standard", for a region without neural voices such as eu-north-1; live mode only
SVAVAK_POLLY_ENGINE=neural
