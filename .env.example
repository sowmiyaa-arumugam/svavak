# Example environment. Copy to .env (git-ignored) and fill in locally.
# Placeholders only: never put a real token, key or personal value in this file.
# AWS credentials are never stored in any file here; sign in with AWS IAM Identity Center (SSO).
# Read by the server (services/server), the TV app's build (apps/tv/app.config.js) and tools/smoke-stream.mjs.

# AI mode: "mock" needs no credentials (the default); "live" calls Bedrock and Polly
SAY_WHEN_MODE=mock

# Static bearer token for every server call except /healthz; the TV's debug build embeds it. At least 16 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SAY_WHEN_DEVICE_TOKEN=<device-token>

# AWS named profile created by `aws configure sso`; read only in live mode
AWS_PROFILE=<your-sso-profile-name>

# AWS region for Bedrock and Polly (plan §8.1: Frankfurt, EU processing)
AWS_REGION=eu-central-1

# Bedrock model id: Nova 2 Lite through the EU geo inference profile (plan §8.1); live mode only
SAY_WHEN_MODEL_ID=eu.amazon.nova-2-lite-v1:0

# Amazon Polly neural voice listed for eu-central-1 (British English: Amy, Emma, Brian, Arthur); live mode only
SAY_WHEN_VOICE=Brian
